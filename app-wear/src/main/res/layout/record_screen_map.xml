<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/record"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.mapsforge.map.android.view.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="48dp" />
    <com.google.android.material.progressindicator.CircularProgressIndicator
        style="@style/progressStyle"
        android:id="@+id/targetProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.wear.widget.CurvedTextView
        tools:ignore="SmallSp"
        android:id="@+id/osm_copyright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#0000"
        android:text="@string/osm_copyright"
        android:textColor="#000"
        android:textSize="8sp"
        app:anchorAngleDegrees="180"
        app:anchorPosition="start"
        app:clockwise="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        tools:ignore="SmallSp"
        android:visibility="gone"
        android:id="@+id/osm_copyright_rect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#0000"
        android:text="@string/osm_copyright"
        android:textColor="#000"
        android:textSize="8sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/zoomOut"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#0000"
        android:contentDescription="@string/record_zoom_out_desc"
        android:gravity="center"
        android:src="@drawable/ic_zoom_out"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/zoomIn"/>
    <ImageView
        android:id="@+id/zoomIn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#0000"
        android:contentDescription="@string/record_zoom_in_desc"
        android:gravity="center"
        android:src="@drawable/ic_zoom_in"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/zoomOut"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <ImageView
        android:id="@+id/centerType"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#0000"
        android:contentDescription="@string/record_center_type_desc"
        android:gravity="center"
        android:src="@drawable/ic_map_center_pos"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/waiting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="10dp"
        android:gravity="center"
        android:text="@string/record_map_waiting"
        android:autoSizeTextType="uniform"
        android:autoSizeMaxTextSize="22sp"
        android:lines="1"
        android:textColor="@color/textDarkerWhite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="parent"/>
    <ImageView
        android:id="@+id/screenUp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/record_screenUp_desc"
        android:gravity="center"
        android:src="@drawable/ic_map_up"
        android:background="#0000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>