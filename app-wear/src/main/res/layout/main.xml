<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:orientation="vertical">
    <Button
        android:id="@+id/workouts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/main_workouts_text"
        android:autoSizeTextType="uniform"
        android:textAllCaps="false"
        android:textStyle="normal"
        android:lines="1"
        android:textColor="@color/textDarkerWhite"
        android:background="#0000"
        android:drawableStart="@drawable/ic_list"/>
    <Button
        android:id="@+id/record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/main_record_text"
        android:autoSizeTextType="uniform"
        android:textAllCaps="false"
        android:textStyle="normal"
        android:lines="1"
        android:textColor="@color/textDarkerWhite"
        android:background="#0000"
        android:drawableStart="@drawable/ic_add_white" />
    <Button
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/main_settings_text"
        android:autoSizeTextType="uniform"
        android:textAllCaps="false"
        android:textStyle="normal"
        android:lines="1"
        android:textColor="@color/textDarkerWhite"
        android:background="#0000"
        android:drawableStart="@drawable/ic_edit" />
</LinearLayout>