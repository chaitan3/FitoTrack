<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/progress"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/bg_progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/progress_line"
        android:visibility="gone"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:background="#0F0"
        app:layout_constraintStart_toStartOf="@id/progress"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/diff_before"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/progressBarBehind"
        app:layout_constraintEnd_toStartOf="@id/progress"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/diff_ahead"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/progressBarAhead"
        app:layout_constraintEnd_toEndOf="@id/progress"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/diff_behind"
        android:visibility="gone"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/progressBarBehind"
        app:layout_constraintStart_toEndOf="@id/progress"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/progress_text_start"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:paddingVertical="2dp"
        android:background="#0000"
        android:gravity="start|center_vertical"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:maxLines="1"
        android:textColor="@color/textWhite"
        app:layout_constraintStart_toEndOf="@id/progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/progress_text_center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="5dp"
        android:background="#0000"
        android:gravity="center"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:maxLines="1"
        android:textColor="@color/textWhite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:id="@+id/progress_text_end"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:paddingVertical="2dp"
        android:background="#0000"
        android:gravity="end|center_vertical"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="8sp"
        android:maxLines="1"
        android:textColor="@color/textWhite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/progress"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <View
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_progress_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
