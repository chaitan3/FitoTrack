<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:keepScreenOn="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/type"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/record_type_desc"
        android:src="@drawable/ic_other"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/target"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@+id/target"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/record_target"
        android:src="@drawable/ic_flag_unset"
        app:layout_constraintStart_toEndOf="@id/type"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/start"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/record_start"
        android:autoSizeTextType="uniform"
        android:autoSizeMaxTextSize="22sp"
        android:lines="1"
        android:textColor="@color/textDarkerWhite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/type"
        app:layout_constraintBottom_toTopOf="@id/location" />
    <ImageView
        android:id="@+id/location"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/record_location_desc"
        android:src="@drawable/ic_gps_no_fix"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/heartRate"
        app:layout_constraintBottom_toTopOf="@id/settings"  />
    <ImageView
        android:id="@+id/heartRate"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/record_heartRate_desc"
        android:src="@drawable/ic_heart_no_fix"
        app:layout_constraintStart_toEndOf="@id/location"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/settings" />
    <ImageView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:contentDescription="@string/record_type_desc"
        android:src="@drawable/ic_edit"
        android:padding="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>